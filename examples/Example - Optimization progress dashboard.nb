Cell["Parse JSON strings to assoc", "Subtitle",
 CellChangeTimes->{{3.936801453262118*^9, 3.936801456442672*^9}, {
  3.9368023354557247`*^9, 
  3.93680233736055*^9}},ExpressionUUID->"899cfdba-5b46-4ef7-98c1-\
93f8b9048455"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"This", " ", "is", " ", "a", " ", "stupid", " ", "trick"}], ",", 
    " ", 
    RowBox[{
     RowBox[{
     "but", " ", "ensures", " ", "numbers", " ", "in", " ", "scientific", " ",
       "notation", " ", "are", " ", "interpreted", " ", 
      RowBox[{"correctly", ":", " ", "https", ":"}]}], "//", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"mathematica", ".", "stackexchange", ".", "com"}], "/", 
         "questions"}], "/", "15051"}], "/", "reading"}], "-", "in", "-", 
      "scientific", "-", "notation", "-", "from", "-", "c", "-", "to", "-", 
      "mathematica"}]}]}], "*)"}], "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"stringToNumber", "[", "string_", "]"}], ":=", 
   RowBox[{
    RowBox[{"ImportString", "[", 
     RowBox[{"string", ",", "\"\<Table\>\""}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{"1", ",", "1"}], "]"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.936801492877895*^9, 3.936801536480377*^9}, {
  3.936802346406733*^9, 3.9368023568609667`*^9}},
 CellLabel->
  "In[1729]:=",ExpressionUUID->"ba7f064f-557e-4891-9896-e9f62b2fe195"],

Cell[BoxData[
 RowBox[{
  RowBox[{"jsonTextToAssoc", "[", "string_", "]"}], ":=", 
  RowBox[{"(", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"stringParts", " ", "=", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"StringSplit", "[", 
        RowBox[{
         RowBox[{"StringDelete", "[", 
          RowBox[{"#", ",", "WhitespaceCharacter"}], "]"}], 
         ",", "\"\<:\>\""}], "]"}], "&"}], "/@", 
      RowBox[{"StringSplit", "[", 
       RowBox[{"string", ",", "\"\<\\n\>\""}], "]"}]}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"Association", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"#", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "->", 
        RowBox[{"stringToNumber", "[", 
         RowBox[{"#", "[", 
          RowBox[{"[", "2", "]"}], "]"}], "]"}]}], "&"}], "/@", 
      "stringParts"}], "]"}]}], "\[IndentingNewLine]", ")"}]}]], "Input",
 CellChangeTimes->{{3.93680197428426*^9, 3.936802120088818*^9}},
 CellLabel->
  "In[1730]:=",ExpressionUUID->"89d20c88-fafc-4f0b-91bc-04676b093f22"],

